{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && pnpm exec prettier --ignore-unknown --write \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting with Prettier",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/check-closeout.sh\"",
            "statusMessage": "Checking changeset + STATE.md",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
