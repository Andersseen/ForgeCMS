{
  "name": "@forge-cms/admin",
  "version": "0.4.1",
  "description": "Angular admin components and utilities for ForgeCMS.",
  "author": "ForgeCMS contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/ForgeCMS.git",
    "directory": "packages/admin"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/ForgeCMS/issues"
  },
  "homepage": "https://github.com/Andersseen/ForgeCMS/tree/main/packages/admin#readme",
  "keywords": [
    "cms",
    "angular",
    "admin",
    "typescript"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-linker.d.ts",
      "default": "./dist/vite-linker.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "test": "vitest run --dir .",
    "test:watch": "vitest --dir .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "@angular/common": "21.2.0",
    "@angular/compiler-cli": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/forms": "21.2.0",
    "@angular/router": "21.2.0",
    "@babel/core": "7.29.0",
    "@voltui/components": "1.0.1",
    "lumen-icons": "0.2.0",
    "rxjs": "7.8.0",
    "vite": "7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/compiler-cli": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@forge-cms/angular": "workspace:*"
  },
  "devDependencies": {
    "@angular/compiler": "21.2.10",
    "@angular/compiler-cli": "21.2.10",
    "@angular/core": "21.2.10",
    "@angular/router": "21.2.10",
    "@babel/core": "7.29.0",
    "@types/babel__core": "7.20.5",
    "@voltui/components": "1.0.1",
    "lumen-icons": "0.2.0",
    "rxjs": "7.8.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
