{
  "name": "@forge-cms/angular",
  "version": "0.10.2",
  "description": "Angular SDK and services for ForgeCMS.",
  "author": "ForgeCMS contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/ForgeCMS.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/ForgeCMS/issues"
  },
  "homepage": "https://github.com/Andersseen/ForgeCMS/tree/main/packages/angular#readme",
  "keywords": [
    "cms",
    "angular",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite-linker.d.ts",
      "default": "./dist/vite-linker.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "test": "vitest run --dir .",
    "test:watch": "vitest --dir .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@forge-cms/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/compiler-cli": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/router": "^21.0.0 || ^22.0.0",
    "@babel/core": "^7.28.0 || ^8.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@angular/common": "21.2.10",
    "@angular/compiler": "21.2.10",
    "@angular/compiler-cli": "21.2.10",
    "@angular/core": "21.2.10",
    "@angular/platform-browser": "21.2.10",
    "@angular/platform-server": "21.2.10",
    "@angular/router": "21.2.10",
    "@babel/core": "7.29.0",
    "@types/babel__core": "7.20.5",
    "jsdom": "27.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@angular/compiler-cli": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
