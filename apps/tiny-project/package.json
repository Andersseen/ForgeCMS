{
  "name": "@forge-cms/tiny-project",
  "version": "0.0.1",
  "private": true,
  "description": "External-style readiness fixture (spec 055): a deliberately tiny users+posts app built only on published @forge-cms/* exports, proving Cloudflare (D1) and portable (libSQL) both work end to end.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "vite build",
    "test": "vitest run --dir . --exclude '**/portable-libsql.integration.test.ts'",
    "test:watch": "vitest --dir .",
    "test:libsql": "vitest run src/tests/portable-libsql.integration.test.ts",
    "test:cloudflare": "vitest run -c vitest.workers.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "clean": "rm -rf dist .analog coverage .wrangler"
  },
  "dependencies": {
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@forge-cms/admin": "workspace:*",
    "@forge-cms/angular": "workspace:*",
    "@forge-cms/api": "workspace:*",
    "@forge-cms/auth": "workspace:*",
    "@forge-cms/cloudflare": "workspace:*",
    "@forge-cms/core": "workspace:*",
    "@forge-cms/db": "workspace:*",
    "@forge-cms/runtime": "workspace:*",
    "@forge-cms/storage": "workspace:*",
    "@libsql/client": "^0.17.3",
    "@voltui/components": "^0.6.0",
    "h3": "^1.15.0",
    "lumen-icons": "^0.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.5.2",
    "@analogjs/vite-plugin-angular": "^2.4.8",
    "@angular/build": "^21.2.10",
    "@angular/compiler-cli": "^21.2.10",
    "@babel/core": "^7.29.0",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.60.0",
    "@types/babel__core": "^7.20.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}
